#!/usr/bin/env sh

usage(){
    echo "Usage: $(basename "${0}") FILE"
    echo 'Convert a file into a base64 encoded url'
}

# check required package
if ! command -v file 2>&1 >/dev/null; then
    echo 'Error: file command is required' >&2; exit 1
fi

if [ ${#} -eq 0 ]; then
    usage >&2; exit 1
elif [ "${1}" = '-h' ] || [ "${1}" = '--help' ] ; then
    usage; exit 0
fi

mime_type=$(file --brief --mime-type "${1}")
if echo "${mime_type}" | grep -q '^text/'; then
    mime_type="${mime_type};charset=utf-8";
fi

echo "data:${mime_type};base64,$(base64 "${1}" | tr -d '\n')"
