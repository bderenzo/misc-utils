#!/usr/bin/env sh

usage(){
    echo "Usage: $(basename "${0}") EXPR"
    echo 'Tiny calculator'
}

if [ ${#} -eq 0 ]; then
    usage; exit 1
elif [ "${1}" = '-h' ] || [ "${1}" = '--help' ] ; then
    usage; exit 0
fi

awk 'function cosd(x)   { return cos(x * atan2(0,-1) / 180) }
     function sind(x)   { return sin(x * atan2(0,-1) / 180) }
     function log10(x)  { return log(x) / log(10) }
     function abs(x)    { return (x < 0) ? -x : x }
     function floor(x)  { return int(x) }
     function asin(x)   { return atan2(x, (1 - x^2)^0.5) }
     function acos(x)   { return atan2((1 - x^2)^0.5, x) }
     function atan(x)   { return atan2(x, 1) }
     function tan(x)    { return sin(x) / cos(x) }
     function nint(x)   { return (x < 0) ? int(x - 0.5) : int(x + 0.5) }
     BEGIN {printf "%.10g\n", '"${1}"'}
'
