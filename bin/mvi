#!/usr/bin/env sh
set -eu

usage() {
    echo "Usage: ${0##*/} FILE [FILE ...]"
    echo 'Bulk rename files using your favorite text editor'
}

# setup temporary files
src_list=$(mktemp "${TMPDIR:-/tmp}/mvi_src.XXXXXX")
dst_list=$(mktemp "${TMPDIR:-/tmp}/mvi_dst.XXXXXX")
trap 'rm -f "${src_list}" "${dst_list}"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

if [ ${#} -eq 0 ]; then
    # default to all files/dirs in current path
    set -- * .[!.]* ..?*
elif [ "${1}" = '-h' ] || [ "${1}" = '--help' ]; then
    usage; exit 0
fi

# add requested files to list
for f in "${@}"; do
    [ -e "${f}" ] && printf '%s\n' "${f}"
done > "${src_list}"

cp "${src_list}" "${dst_list}"
${EDITOR:-vi} "${dst_list}"

if cmp -s "${src_list}" "${dst_list}"; then
    echo 'Nothing to do' >&2
    exit 0
elif [ "$(wc -l < "${src_list}")" -ne "$(wc -l < "${dst_list}")" ]; then
    echo 'Error: source and destination number of lines differs' >&2
    exit 1
fi

count=0
# read both files at the same time and process renames line-by-line
while IFS= read -r src <&3 && IFS= read -r dst <&4; do
    if [ "${src}" != "${dst}" ]; then
        mkdir -p -- "$(dirname -- "${dst}")"
        echo "${src} -> ${dst}"
        if [ -e "${dst}" ]; then
            echo "Warning: Can't proceed, destination exists!" >&2
            continue
        elif git ls-files --error-unmatch -- "${src}" >/dev/null 2>&1; then
            git mv -- "${src}" "${dst}"
        else
            mv -n -- "${src}" "${dst}"
        fi
        count=$((count + 1))
    fi
done 3<"${src_list}" 4<"${dst_list}"
echo "${count} files renamed" >&2
