#!/usr/bin/env sh
set -eu

usage() {
    echo "Usage: ${0##*/} CHAINFILE"
    echo 'Display basic certificate information from a certificate bundle'
}

if [ ${#} -eq 0 ]; then
    usage >&2; exit 1
elif [ "${1}" = '-h' ] || [ "${1}" = '--help' ]; then
    usage; exit 0
fi

# check required package
if ! command -v openssl >/dev/null 2>&1; then
    echo 'Error: openssl is required' >&2; exit 1
fi

chain="${1}"
if [ ! -f "${chain}" ]; then
    echo "Error: no such file '${chain}'" >&2
    exit 1
fi

awk -v cmd='openssl x509 -issuer -subject -enddate -fingerprint -noout -ext subjectAltName 2>/dev/null' '
    /BEGIN CERTIFICATE/ { if (n++) { print "-"; fflush() }; c=1 }
    c                   { print | cmd }
    /END CERTIFICATE/   { close(cmd); c=0 }
' "${chain}" \
  | sed -e '/^X509v3 Subject Alternative Name/d' \
        -e 's/^notAfter/expire/' \
        -e 's/^SHA1 Fingerprint/sha1/' \
        -e 's/^[[:space:]][[:space:]]*/alt=/' \
        -e 's/=/\t/'
