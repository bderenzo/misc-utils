#!/usr/bin/env sh
set -eu

usage() {
    cat << EOF
Usage: ${0##*/} [OPTS]
Tiny network data info viewer

OPTIONS:
   -o --output FIELDS      comma-separated fields (interface,ip,gateway,mask,cidr,dns,public)
   -h --help               show this help
EOF
}

_public_ip() {
    if command -v dig >/dev/null 2>&1; then
        public_ip=$(dig +short +time=3 +tries=1 @208.67.222.222 myip.opendns.com | sed -e '/^;/d' -e 's/"//g')
    elif command -v curl >/dev/null 2>&1; then
        public_ip=$(curl --silent --max-time 3 https://api.ipify.org)
    elif command -v wget >/dev/null 2>&1; then
        public_ip=$(wget -qO- --timeout=3 https://api.ipify.org)
    fi
    echo "${public_ip:-unknown}"
}

fields='' gateway='' iface='' ip=''
while [ ${#} -gt 0 ]; do
    case "${1}" in
        -o|--output)   fields="${2}"; shift 2;;
        -h|--help)     usage; exit 0;;
        *)             echo "unknown ${1} option" >&2; usage >&2; exit 1;;
    esac
done

set -- $(ip route get 1.0.0.0 2>/dev/null)
while [ ${#} -gt 1 ]; do
    case "${1}" in
        via) gateway="${2}";;
        dev) iface="${2}";;
        src) ip="${2}";;
    esac
    shift
done

if [ -z "${iface}" ]; then
    echo 'Error: could not retrieve network data' >&2; exit 1
fi

masklen=$(ip -o -f inet addr show dev "${iface}" | awk '/scope global/ {split($4,v,"/"); print v[2]; exit}')
m=$(( 0xffffffff << (32 - ${masklen:-0}) & 0xffffffff ))
mask="$(( m >> 24 )).$(( m >> 16 & 255 )).$(( m >> 8 & 255 )).$(( m & 255 ))"
dns=$(awk '/^nameserver / {print $2}' /etc/resolv.conf)

if [ -z "${fields}" ]; then
    printf '%-12s %s\n' interface "${iface}" private-ip "${ip}" gateway "${gateway}" mask "${mask}" cidr "${masklen}" dns "${dns}" public-ip "$(_public_ip)"
    exit 0
fi

# process the requested fields
out=''
IFS=','
for field in ${fields}; do
    case "${field}" in
        interface) out="${out}${iface} ";;
        ip)        out="${out}${ip} ";;
        gateway)   out="${out}${gateway} ";;
        mask)      out="${out}${mask} ";;
        cidr)      out="${out}${masklen} ";;
        dns)       out="${out}${dns} ";;
        public)    out="${out}$(_public_ip) ";;
        *)         echo "unknown ${field} field" >&2; usage >&2; exit 1;;
    esac
done
echo "${out% }"
