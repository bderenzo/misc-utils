#!/usr/bin/env sh
set -eu

usage() {
    cat << EOF
Usage: ${0##*/} [OPTS] SERVER1 [SERVER2 ...] -- COMMAND
Parallel SSH command execution

OPTIONS:
   -o --ssh-opts SSH_OPTS  add ssh option(s)
   -e --no-stderr          hide ssh stderr (banners, warnings)
   -q --quiet              only print results
   -d --date               print date
   -h --help               show this help
EOF
}

date=false
quiet=false
hosts=''
sshopt=''
stderr='/dev/stdout'
while [ ${#} -gt 0 ]; do
    case "${1}" in
        -o|--ssh-opts)  shift; sshopt="${sshopt} ${1}";;
        -e|--no-stderr) stderr='/dev/null';;
        -h|--help)      usage; exit 0;;
        -d|--date)      date=true;;
        -q|--quiet)     quiet=true;;
        --)             shift; break;;
        -*)             echo "unknown ${1} option" >&2; usage >&2; exit 1;;
        *)              hosts="${hosts} ${1}";;
    esac
    shift
done
[ -z "${hosts}" ] && { usage >&2; exit 1; }

# cleanup on Ctrl+C
trap 'kill 0; exit 130' INT

n=0
t0=$(date +%s)
for h in ${hosts}; do
    n=$((n + 1))
    (
        out=$(ssh ${sshopt} "${h}" -- "${@}" 2>"${stderr}") || :
        ${date} && h="${h} $(date +'%Y/%m/%d @ %H:%M:%S')"
        ${quiet} || out=$(printf '\033[1;31m%s\033[0m\n%s' "${h}" "${out}")
        [ -n "${out}" ] && printf '%s\n' "${out}"
    ) &
done
wait
if ! ${quiet}; then
    echo >&2
    echo "Total: ${n} host(s), $(( $(date +%s) - t0 )) second(s)" >&2
fi
