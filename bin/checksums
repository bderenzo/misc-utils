#!/usr/bin/env sh
set -eu

usage() {
    cat << EOF
Usage: ${0##*/} [OPTS] [PATH]
Generate and verify directory checksums

OPTIONS:
   -c --check              verify checksums [default]
   -g --generate           generate a new checksums file
   -d --delete             remove generated checksums files
   -h --help               show this help
EOF
}

dir='.'
action='check'
hash_link='.checksums_latest.sha256'

while [ ${#} -gt 0 ]; do
    case "${1}" in
        -g|--generate) action='generate'; shift;;
        -c|--check)    action='check'; shift;;
        -d|--delete)   action='delete'; shift;;
        -h|--help)     usage; exit 0;;
        -*)            echo "unknown ${1} option" >&2; usage >&2; exit 1;;
        *)             dir="${1}"; shift;;
    esac
done

if ! command -v sha256sum >/dev/null 2>&1; then
    echo "Error: missing command: 'sha256sum'" >&2; exit 1
fi

if [ ! -d "${dir}" ]; then
    echo "Error: no such directory '${dir}'" >&2; exit 1
fi

cd "${dir}" || exit 1
echo "Directory: ${PWD}" >&2

if [ "${action}" = 'generate' ]; then
    hash_file=".checksums_$(date +'%Y%m%d_%H%M%S').sha256"
    echo 'Generate checksums...' >&2
    find . -type f ! -name '.checksums_*.sha256' -exec sha256sum {} + > "${hash_file}"
    echo "Checksums file: ${hash_file}" >&2
    ln -snf "${hash_file}" "${hash_link}"
elif [ "${action}" = 'delete' ]; then
    echo 'Remove checksums files...' >&2
    find . -maxdepth 1 -name '.checksums_*.sha256' -print -delete | cut -d'/' -f2-
elif [ "${action}" = 'check' ]; then
    if [ ! -f "${hash_link}" ]; then
        echo "Error: no such file '${hash_link}'" >&2
        echo 'Execute with --generate flag first' >&2
        exit 1
    fi
    echo "Checksums file: $(readlink "${hash_link}")" >&2
    echo 'Verify checksums...' >&2
    if sha256sum -c "${hash_link}" 2>&1 | grep -v ': OK$'; then
        exit 1
    fi
    echo 'OK'
fi
