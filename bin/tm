#!/usr/bin/env sh
set -eu

usage() {
    echo "Usage: $(basename "${0}") [NAME]"
    echo 'Quick attach or create tmux sessions'
}

if [ "${1:-}" = '-h' ] || [ "${1:-}" = '--help' ]; then
    usage; exit 0
elif [ -n "${1:-}" ]; then
    echo "Create or attach to session: ${1}"
    tmux attach-session -t "${1}" 2>/dev/null \
      || tmux new-session -s "${1}"
    echo
    echo "Sessions list:"
fi

tmux ls 2>/dev/null || echo 'No running session...'
