#!/usr/bin/env sh
set -eu

usage() {
    echo "Usage: ${0##*/} [NAME]"
    echo 'Quick attach or create tmux sessions'
}

if ! command -v tmux >/dev/null 2>&1; then
    echo "Error: missing command: 'tmux'" >&2; exit 1
fi

if [ "${1:-}" = '-h' ] || [ "${1:-}" = '--help' ]; then
    usage; exit 0
elif [ -n "${1:-}" ]; then
    echo "Create or attach to session: ${1}" >&2
    tmux new-session -A -s "${1}"
    echo >&2
    echo 'Sessions list:' >&2
fi

tmux ls 2>/dev/null || echo 'No running session...' >&2
