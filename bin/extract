#!/usr/bin/env sh

usage(){
    echo "Usage: $(basename "${0}") ARCHIVE"
    echo 'Tiny archive decompression wrapper'
    echo 'Supported format: zip|7z|rar|gz|bz2|xz|lzma|tar|tar.gz|tar.bz2|tar.xz|Z|exe'
}

if [ ${#} -eq 0 ]; then
    usage >&2; exit 1
elif [ "${1}" = '-h' ] || [ "${1}" = '--help' ] ; then
    usage; exit 0
fi

archive="${1}"
if ! [ -f "${archive}" ]; then
    echo >&2 "'${archive}' file does not exist" >&2; exit 2
fi

# get archive name
name="$(echo "${archive}" | sed -E 's,\.(zip|7z|rar|gz|bz2|xz|lzma|tar|tar.gz|tar.bz2|tar.xz|tgz|tbz2|txz|Z|exe)$,,')"
if [ -e "${name}" ]; then
    echo >&2 "'${name}' file or direcotry already exist"
    exit 3
fi

# always extract in a subdirectory
mkdir -- "${name}"
cd -- "${name}" || exit 1
mv -- ../"${archive}" .
case "${archive}" in
        *.tar)            tar -xvf     ./"${archive}" ;;
        *.tar.gz|*.tgz)   tar -xvzf    ./"${archive}" ;;
        *.tar.bz2|*.tbz2) tar -xvjf    ./"${archive}" ;;
        *.tar.xz|*.txz)   tar -xvJf    ./"${archive}" ;;
        *.zip)            unzip        ./"${archive}" ;;
        *.7z)             7z x         ./"${archive}" ;;
        *.rar)            unrar x -ad  ./"${archive}" ;;
        *.gz)             gunzip       ./"${archive}" ;;
        *.bz2)            bunzip2      ./"${archive}" ;;
        *.xz)             unxz         ./"${archive}" ;;
        *.lzma)           unlzma       ./"${archive}" ;;
        *.Z)              uncompress   ./"${archive}" ;;
        *.exe)            cabextract   ./"${archive}" ;;
        *)                echo >&2 "'${archive}' unknown archive format"; exit 1 ;;
esac
rc=$?
if [ "${rc}" -eq 0 ]; then
    rm -- "${archive}"
    # TODO: if the archive already contain a directory remove it
fi

