#!/usr/bin/env sh
set -eu

usage() {
    echo "Usage: ${0##*/} ARCHIVE"
    echo 'Tiny archive decompression wrapper'
    echo 'Supported format: zip|7z|rar|gz|bz2|xz|lzma|tar|tar.gz|tar.bz2|tar.xz|tgz|tbz2|txz|Z|exe'
}

if [ ${#} -eq 0 ]; then
    usage >&2; exit 1
elif [ "${1}" = '-h' ] || [ "${1}" = '--help' ]; then
    usage; exit 0
fi

archive="${1}"
if [ ! -f "${archive}" ]; then
    echo "Error: no such file '${archive}'" >&2; exit 1
fi

# get archive name
name="$(echo "${archive}" | sed -E 's,\.(zip|7z|rar|gz|bz2|xz|lzma|tar|tar.gz|tar.bz2|tar.xz|tgz|tbz2|txz|Z|exe)$,,')"
if [ "${name}" = "${archive}" ]; then
    echo "Error: unknown archive format '${archive}'" >&2; exit 1
elif [ -e "${name}" ]; then
    echo "Error: '${name}' already exists" >&2
    exit 1
fi

# always extract in a subdirectory
mkdir -- "${name}"
mv -- "${archive}" "${name}/"
cd -- "${name}" || exit 1
archive="${archive##*/}"
case "${archive}" in
    *.tar)            tar -xvf     ./"${archive}";;
    *.tar.gz|*.tgz)   tar -xvzf    ./"${archive}";;
    *.tar.bz2|*.tbz2) tar -xvjf    ./"${archive}";;
    *.tar.xz|*.txz)   tar -xvJf    ./"${archive}";;
    *.zip)            unzip        ./"${archive}";;
    *.7z)             7z x         ./"${archive}";;
    *.rar)            unrar x -ad  ./"${archive}";;
    *.gz)             gunzip       ./"${archive}";;
    *.bz2)            bunzip2      ./"${archive}";;
    *.xz)             unxz         ./"${archive}";;
    *.lzma)           unlzma       ./"${archive}";;
    *.Z)              uncompress   ./"${archive}";;
    *.exe)            cabextract   ./"${archive}";;
    *)                echo "Error: unknown archive format '${archive}'" >&2; exit 1;;
esac || exit
rm -f -- "${archive}"

# when archive contains only a directory, drop the extra level
set -- .[!.]* ..?* *
if [ ${#} -eq 3 ] && [ ! -e "${1}" ] && [ ! -e "${2}" ] && [ -d "${3}" ]; then
    cd ..
    base="${name##*/}"
    mv -- "${base}" "${archive}"
    mv -- "${archive}/${3}" "${base}"
    rmdir -- "${archive}"
fi
