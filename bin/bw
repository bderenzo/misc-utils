#!/usr/bin/env sh

usage(){
    _std="${1}" _rc=$((${1} - 1))
    echo >&"${_std}" "Usage: $(basename "${0}") [INTERFACE]"
    echo >&"${_std}" "Display bandwith (up and down) for an interface"
    exit ${_rc}
}

if [ "${1}" = '-h' ] || [ "${1}" = '--help' ] ; then
    usage 1
fi

dev=${1}
if [ -z "${dev}" ]; then
    # select default device
    dev="$(ip route get 1.0.0.0 | awk '{print $5}')"
elif ! grep -q "^ *${dev}:" /proc/net/dev; then
    echo >&2 "Error: device ${dev} not found"
    echo 'Avalaible device(s):'
    awk -F: '/:/ {gsub(/ /,""); print "+ "$1}' /proc/net/dev
    exit 2
fi

echo -n "loading... "
get_in_bytes(){  awk -v reg="^ *${1}:" '$1 ~ reg {print $2}'  /proc/net/dev; }
get_out_bytes(){ awk -v reg="^ *${1}:" '$1 ~ reg {print $10}' /proc/net/dev; }

while sleep 1; do
    rx=$(get_in_bytes "${dev}") tx=$(get_out_bytes "${dev}")
    awk "BEGIN { printf(\"\033[K\r${dev}: Rx %.2f MB/s | Tx %.2f MB/s | All %.2f MB/s \", \
        (${rx}-${rxo:-$rx})/1048576, \
        (${tx}-${txo:-$tx})/1048576, \
        (${tx}+${rx}-${txo:-$tx}-${rxo:-$rx})/1048576 ) }"
    rxo=${rx} txo=${tx}
done

