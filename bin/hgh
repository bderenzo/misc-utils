#!/usr/bin/env sh

usage(){
    echo "Usage: $(basename "${0}") [COLOR] PATTERN"
    echo 'Highlight words in a text'
}

if [ ${#} -eq 0 ]; then
    usage >&2; exit 1
elif [ "${1}" = '-h' ] || [ "${1}" = '--help' ] ; then
    usage; exit 0
fi

if [ ${#} -lt 2 ]; then
    color=31
    match="${1}"
else
    case "${1}" in
	black)   color=30;;
	red)     color=31;;
	green)   color=32;;
	yellow)  color=33;;
	blue)    color=34;;
	magenta) color=35;;
	cyan)    color=36;;
    esac
    match="${2}"
fi
fg_c=$(echo "\e[1;${color}m")
c_rs=$(echo "\e[0m")
sed "s/${match}/${fg_c}\0${c_rs}/g"

