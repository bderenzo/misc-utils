#!/usr/bin/env sh

usage(){
    echo "Usage: (compress) $(basename "${0}") FILE [FILE ...]"
    echo "     (uncompress) $(basename "${0}") -d"
    echo 'Generate base64 encoded archive for copy and paste data'
}

if [ ${#} -eq 0 ]; then
    usage >&2; exit 1
elif [ "${1}" = '-h' ] || [ "${1}" = '--help' ] ; then
    usage; exit 0
elif [ "${1}" = '-p' ]; then
    echo '  compress: tar -czf - . | base64'
    echo 'uncompress: base64 -d | tar -xz'
elif [ "${1}" = '-d' ]; then
    echo 'Paste 64bits encoded data, then press CTRL+D twice'
    echo
    base64 -d | tar -xz
    echo
else
    echo "Copy 64bits encoded data below, to extract execute: $(basename "${0}") -d"
    echo
    tar -czf - "${@}" | base64
fi
