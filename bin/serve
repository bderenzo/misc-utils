#!/usr/bin/env sh
set -eu

usage() {
    cat << EOF
Usage: ${0##*/} [OPTS]
Tiny http server

OPTIONS:
   -b --bind HOST          bind address [default: 0.0.0.0]
   -p --port PORT          listening port [default: 8888]
   -d --dir DIR            served directory [default: ./]
   -h --help               show this help
EOF
}

# default values
host='0.0.0.0' port='8888' dir='./'

while [ ${#} -gt 0 ]; do
    case "${1}" in
        -p|--port)  port="${2}"; shift 2;;
        -b|--bind)  host="${2}"; shift 2;;
        -d|--dir)   dir="${2}"; shift 2;;
        -h|--help)  usage; exit 0;;
        *)          echo "unknown ${1} option" >&2; usage >&2; exit 1;;
    esac
done

# check required package
if ! command -v python3 >/dev/null 2>&1; then
    echo "Error: command missing 'python3'" >&2
    exit 1
fi

echo "Serve ${dir} on ${host}:${port}" >&2
python3 -m http.server "${port}" --bind "${host}" --directory "${dir}" 2>&1 >/dev/null
