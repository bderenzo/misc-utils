#!/usr/bin/env sh
set -eu

usage() {
    cat << EOF
Usage: ${0##*/} [OPTS]
Tiny speedtest client

OPTIONS:
   -d --download-url URL   download test URL [default: Cloudflare 50MB]
   -u --upload-url URL     upload test URL [default: Cloudflare]
   -n --runs N             number of runs [default: 3]
   -h --help               show this help
EOF
}

dl_url='https://speed.cloudflare.com/__down?bytes=50000000'
ul_url='https://speed.cloudflare.com/__up'
n=3

while [ ${#} -gt 0 ]; do
    case "${1}" in
        -h|--help)         usage; exit 0;;
        -d|--download-url) dl_url="${2}"; shift;;
        -u|--upload-url)   ul_url="${2}"; shift;;
        -n|--runs)         n="${2}"; shift;;
        -*)                echo "unknown ${1} option" >&2; usage >&2; exit 1;;
        *)                 break;;
    esac
    shift
done

if ! [ "${n}" -gt 0 ] 2>/dev/null; then
    echo "Error: invalid number of runs '${n}'" >&2; exit 1
fi

for cmd in curl awk dd; do
    if ! command -v "${cmd}" >/dev/null 2>&1; then
        echo "Error: missing command '${cmd}'" >&2; exit 1
    fi
done

measure() {
    key="${1}"
    url="${2}"
    printf '%s' "${key}load" >&2
    i=0
    while [ "${i}" -lt "${n}" ]; do
        printf '.' >&2
        case "${key}" in
            down)  curl -sfL -o /dev/null -w "%{speed_${key}load}\n" "${url}" || echo 0;;
            up)    dd if=/dev/zero bs=5M count=1 2>/dev/null \
                     | curl -sfL -X POST -o /dev/null -w "%{speed_${key}load}\n" --data-binary @- "${url}" || echo 0;;
        esac
        i=$((i + 1))
    done | awk -v n="${n}" \
       '{ t += $1 } END { a = t / n; printf "\n%.0f Mbit/s - %.1f MiB/s\n", a * 8 / 1e6, a / 1048576 }'
}

measure 'down' "${dl_url}"
measure 'up'   "${ul_url}"
