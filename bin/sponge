#!/usr/bin/env sh
set -eu

usage() {
    echo "Usage: ${0##*/} FILE"
    echo 'Soak up standard input and write to a file'
}

if [ ${#} -eq 0 ]; then
    usage >&2; exit 1
elif [ "${1}" = '-h' ] || [ "${1}" = '--help' ]; then
    usage; exit 0
fi

outfile="${1}"
tmpfile=$(mktemp "${TMPDIR:-/tmp}/sponge.XXXXXX")
trap 'rm -f "${tmpfile}"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

cat > "${tmpfile}"
cat "${tmpfile}" > "${outfile}"
