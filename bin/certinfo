#!/usr/bin/env sh
set -eu

usage() {
    echo "Usage: ${0##*/} DOMAIN"
    echo 'Display basic certificate information from a domain'
}

if [ ${#} -eq 0 ]; then
    usage >&2; exit 1
elif [ "${1}" = '-h' ] || [ "${1}" = '--help' ]; then
    usage; exit 0
fi

if ! command -v openssl >/dev/null 2>&1; then
    echo "Error: missing command 'openssl'" >&2; exit 1
fi

domain="${1#*://}"
domain="${domain%%/*}"
printf 'domain\t%s\n' "${domain}"
echo | openssl s_client -connect "${domain}:443" -prexit 2>/dev/null \
     | openssl x509 -issuer -subject -enddate -fingerprint -noout -ext subjectAltName \
     | sed -e '/^X509v3 Subject Alternative Name/d' \
           -e 's/^notAfter/expire/' \
           -e 's/^SHA1 Fingerprint/sha1/' \
           -e 's/^[[:space:]][[:space:]]*/alt=/' \
           -e 's/=/\t/'
