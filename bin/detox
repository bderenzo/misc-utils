#!/usr/bin/env sh
set -eu
# inspired from https://github.com/dharple/detox

usage() {
    echo "Usage: ${0##*/} [-n|--dry-run] FILE|DIR [FILE|DIR ...]"
    echo 'Rename files and directories without special characters'
}

dry=false
if [ ${#} -eq 0 ]; then
    usage >&2; exit 1
elif [ "${1}" = '-h' ] || [ "${1}" = '--help' ]; then
    usage; exit 0
elif [ "${1}" = '-n' ] || [ "${1}" = '--dry-run' ]; then
    dry=true
    shift
fi

accent='çāáǎàēéěèêïîīíǐìôōóǒòûūúǔùǖǘǚǜĀÁǍÀĒÉĚÈĪÍǏÌŌÓǑÒŪÚǓÙǕǗǙǛ'
normal='caaaaeeeeeiiiiiiooooouuuuuuuuuAAAAEEEEIIIIOOOOUUUUUUUU'
for e in "${@}"; do
    cur="$(basename -- "${e}")"
    new="$(printf '%s\n' "${cur}" | sed -E -e 's/^[^.A-Za-z0-9]+//' -e 's/[^A-Za-z0-9]+$//' -e 's/[^A-Za-z0-9]+/./g' -e "y/${accent}/${normal}/")"
    if [ "${cur}" != "${new}" ]; then
        dir="$(dirname -- "${e}")"
        echo "${e} -> ${dir}/${new}"
        if [ -e "${dir}/${new}" ]; then
            echo "Warning: can't proceed, destination exists!" >&2
        elif ! ${dry}; then
            mv -- "${e}" "${dir}/${new}"
        fi
    fi
done
