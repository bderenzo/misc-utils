#!/usr/bin/env sh
set -eu

usage() {
    echo "Usage: ${0##*/} [FILE ...]"
    echo 'Strip terminal control sequences from text'
}

if [ "${1:-}" = '-h' ] || [ "${1:-}" = '--help' ]; then
    usage; exit 0
fi

esc=$(printf '\033')
cr=$(printf '\r')
nl='
'

sed -E "
s/${cr}/\\${nl}/g;
s/(\\\\r)/\\${nl}/g;
s/(${esc}\[(H|2J|3J|K))+/\\${nl}/g;
s/((\\\x1b|\\033|\\\\e)\[(H|2J|3J|K))+/\\${nl}/g;
s/${esc}\[[0-9;?]*[[:alpha:]]//g;
s/(\\\x1b|\\033|\\\\e)\[[0-9;?]*[[:alpha:]]//g;
" "${@}"
