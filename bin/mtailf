#!/usr/bin/env bash

usage(){
    echo "Usage: $(basename "${0}") FILE [FILE ...]"
    echo 'Mutliple grouped tailf'
}

if [ ${#} -eq 0 ]; then
    usage >&2; exit 1
elif [ "${1}" = '-h' ] || [ "${1}" = '--help' ] ; then
    usage; exit 0
fi

# print with a fixed width
_p(){ printf "%*.*s" "-${1}" "${1}" "${2}"; }

# kill on signal
trap 'kill $(jobs -p) &> /dev/null' SIGHUP SIGINT SIGTERM

# get longest filename
maxlen=0
for file in "${@}"; do
    len="$(basename "${file}" | wc -c)"
    (( len > maxlen )) && maxlen="${len}"
done

# tailling files
for file in "${@}"; do
    if ! [ -f "${file}" ]; then
        echo >&2 "Error: no such file '${file}'"
        continue
    fi
    echo "reading ${file}"
    filename="$(basename "${file}")"
    tail -n 0 -f "${file}" 2>/dev/null | while read -r line; do
        echo "$(_p "${maxlen}" "${filename}")| "${line}""
    done &
done
wait
